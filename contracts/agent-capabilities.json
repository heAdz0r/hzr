{
  "schema_version": 1,
  "product": "HZR",
  "control_plane": "hzr",
  "internal_engines": [
    "rtk",
    "grepai",
    "icm"
  ],
  "routes": [
    {
      "id": "read",
      "instead_of": "File outline or line range",
      "command": "hzr read <file> --outline",
      "guidance": "or `--from A --to B`; native Read stays the default for whole files.",
      "managed_block": true
    },
    {
      "id": "search",
      "instead_of": "Search by intent",
      "command": "hzr search \"<intent>\"",
      "guidance": "`--mode exact` for a known literal.",
      "managed_block": true
    },
    {
      "id": "write",
      "instead_of": "Atomic multi-file edit (optional)",
      "command": "hzr write batch ...",
      "guidance": "native Edit/Write stay the default.",
      "managed_block": true
    },
    {
      "id": "memory",
      "instead_of": "Durable decisions and fixes",
      "command": "hzr memory recall|store",
      "guidance": "project scope by default; `--scope global` only for user-wide preferences.",
      "managed_block": true
    },
    {
      "id": "context",
      "instead_of": "Unfamiliar or cross-cutting area",
      "command": "hzr context plan \"<intent>\"",
      "guidance": "bound with `--max-tokens N`.",
      "managed_block": true
    },
    {
      "id": "shell",
      "instead_of": "Shell command outside the hook",
      "command": "hzr exec run '<cmd>'",
      "guidance": "hook-routed Bash is already managed.",
      "managed_block": true
    },
    {
      "id": "project_build",
      "instead_of": "build this project",
      "command": "hzr exec run '<project build command>'",
      "guidance": "Project builds are ordinary managed shell commands; hzr build is not a generic project-build wrapper.",
      "managed_block": false
    },
    {
      "id": "tdd",
      "instead_of": "optional TDD",
      "command": "hzr tdd",
      "guidance": "Use only when requested, repository-required, or justified by regression risk.",
      "managed_block": false
    },
    {
      "id": "exact_raw",
      "instead_of": "Exact unfiltered output",
      "command": "HZR_RAW_FIDELITY=1 HZR_RAW_FIDELITY_REASON=<reason> hzr exec run '<command>'",
      "guidance": "reason: binary, checksum, machine_protocol, complete_log, full_patch or verbatim_source. `cat`, `sed -n` and `head` through the hook are already exact.",
      "managed_block": true
    }
  ],
  "mcp_tools": [
    {
      "name": "hzr_context_plan",
      "purpose": "Build bounded graph-first evidence for unfamiliar or cross-cutting work.",
      "tier": "core"
    },
    {
      "name": "hzr_search",
      "purpose": "Find code by intent or by a known exact literal.",
      "tier": "core"
    },
    {
      "name": "hzr_memory_recall",
      "purpose": "Recall durable decisions, resolved errors, and prior context.",
      "tier": "core"
    },
    {
      "name": "hzr_memory_get",
      "purpose": "Read one exact memory ID after verifying namespace ownership.",
      "tier": "specialist"
    },
    {
      "name": "hzr_memory_store",
      "purpose": "Persist one durable fact or finished handoff, not ephemeral state.",
      "tier": "core"
    },
    {
      "name": "hzr_memory_update",
      "purpose": "Replace one superseded memory after namespace ownership is verified.",
      "tier": "specialist"
    },
    {
      "name": "hzr_memory_forget",
      "purpose": "Delete one invalid memory after namespace ownership is verified.",
      "tier": "specialist"
    },
    {
      "name": "hzr_memory_prune",
      "purpose": "Preview or remove low-weight memories in one namespace.",
      "tier": "specialist"
    },
    {
      "name": "hzr_codec",
      "purpose": "Explicit duplicate-paragraph transform or shadow measurement; not a default step for generated prose. Host delivery and economic credit remain unverified.",
      "tier": "specialist"
    },
    {
      "name": "hzr_read",
      "purpose": "Read exact full or bounded batch content with total token budget, hashes and explicit continuation.",
      "tier": "core"
    },
    {
      "name": "hzr_write",
      "purpose": "Apply confined atomic patch or create operations with typed CAS receipts.",
      "tier": "core"
    },
    {
      "name": "hzr_exec",
      "purpose": "Run commands, or start/wait/cancel bounded background jobs through daemon policy and accounting.",
      "tier": "core"
    },
    {
      "name": "hzr_observability",
      "purpose": "Return typed daemon, engine, capability, and workspace health.",
      "tier": "specialist"
    },
    {
      "name": "hzr_doctor",
      "purpose": "Run desired-state diagnostics for the exact MCP workspace.",
      "tier": "specialist"
    }
  ],
  "harnesses": {
    "claude": {
      "instruction_file": "CLAUDE.md",
      "native_hook_routing": true,
      "response_codec": {
        "global_replacement": false,
        "coverage": "instructed",
        "mechanism": "managed_instruction_and_session_start",
        "economic_credit": false,
        "default_prose_policy": "concise_generation_no_post_hoc_transform"
      },
      "hooks": {
        "adapter_contract": "hzr_host_hooks_v1",
        "documentation_checked": "2026-09-04",
        "source": "https://code.claude.com/docs/en/hooks",
        "minimum_verified_host_version": null,
        "declared_pre_tool_input_rewrite": true,
        "implemented_pre_tool_tools": [
          "Bash",
          "Agent",
          "Task"
        ],
        "argument_rewrite_permission": "preserve_host_permission_flow",
        "declared_post_tool_output_replacement": true,
        "implemented_post_tool_output_replacement": true,
        "post_tool_output_opt_in": "hzr hooks observe --native-mode observe --replace-output",
        "implemented_post_tool_tools": [
          "Bash:cargo_test_success_summary"
        ],
        "post_tool_output_schema": "stdout:string,stderr:string,interrupted:false,isImage:false",
        "post_tool_output_recovery": "private_content_addressed_original_stdout",
        "post_tool_output_economic_credit": false,
        "native_file_policy": "observe_without_optimization_denial",
        "unsupported_shape": "pass_through_to_host_permissions",
        "installation": "managed_opt_in",
        "delivery": "unverified",
        "economic_credit": false
      }
    },
    "codex": {
      "instruction_file": "AGENTS.md",
      "native_hook_routing": false,
      "response_codec": {
        "global_replacement": false,
        "coverage": "instructed",
        "mechanism": "managed_instruction",
        "economic_credit": false,
        "default_prose_policy": "concise_generation_no_post_hoc_transform"
      },
      "hooks": {
        "adapter_contract": "hzr_host_hooks_v1",
        "documentation_checked": "2026-09-04",
        "source": "https://learn.chatgpt.com/docs/hooks",
        "minimum_verified_host_version": null,
        "declared_pre_tool_input_rewrite": true,
        "implemented_pre_tool_tools": [
          "Bash"
        ],
        "argument_rewrite_permission": "explicit_bypassPermissions_only",
        "declared_post_tool_output_replacement": false,
        "implemented_post_tool_output_replacement": false,
        "native_file_policy": "observe_without_optimization_denial",
        "unsupported_shape": "pass_through_to_host_permissions",
        "installation": "manual_opt_in",
        "delivery": "unverified",
        "economic_credit": false
      }
    },
    "managed_agent": {
      "instruction_file": null,
      "native_hook_routing": false,
      "tool_names": [
        "hzr_context",
        "hzr_search",
        "hzr_read",
        "hzr_edit",
        "hzr_write",
        "hzr_memory_recall",
        "hzr_memory_store",
        "hzr_memory_forget",
        "hzr_memory_update",
        "hzr_memory_prune",
        "hzr_exec"
      ]
    }
  }
}
