+//! Read-only access to an agtx store.
+//!
+//! [`Database::open_project`] and [`Database::open_global`] are constructors for
+//! the *owner* of a store: they create directories, rename a legacy database,
+//! set `journal_mode=WAL`, chmod the file and run `init_*_schema`, which issues
+//! `CREATE TABLE`/`ALTER TABLE`. None of that is acceptable for an outside
+//! observer, which must be able to look at a live store without changing a byte
+//! of it.
+//!
+//! This module is the read-only counterpart. It opens exactly the files that
+//! already exist, with `SQLITE_OPEN_READ_ONLY`, `PRAGMA query_only=ON` and
+//! extension loading left disabled, and it introspects the schema instead of
+//! migrating it. `immutable=1` is deliberately *not* used: the store may have a
+//! live WAL writer, and an immutable open would read a stale or torn database.
+
+use anyhow::{Context, Result};
+use rusqlite::{Connection, OpenFlags};
+use std::path::{Path, PathBuf};
+
+/// SQLite busy timeout for observer reads. Short on purpose: a monitor must
+/// never hold the writer up, and a contended read is better retried on the next
+/// poll than blocked on here.
+pub const READ_BUSY_TIMEOUT_MS: u32 = 250;
+
+/// A read-only handle on one agtx SQLite file.
+pub struct ReadOnlyDb {
+    conn: Connection,
+    path: PathBuf,
+}
+
+impl ReadOnlyDb {
+    /// Open an existing database file read-only.
+    ///
+    /// Fails when the file does not exist — `SQLITE_OPEN_READ_ONLY` without
+    /// `SQLITE_OPEN_CREATE` cannot bring one into being, which is the point.
+    pub fn open(path: &Path) -> Result<Self> {
+        let flags = OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX;
+        let conn = Connection::open_with_flags(path, flags)
+            .with_context(|| format!("Failed to open {:?} read-only", path))?;
+        conn.busy_timeout(std::time::Duration::from_millis(u64::from(
+            READ_BUSY_TIMEOUT_MS,
+        )))?;
+        // `query_only` makes any accidental write a runtime error rather than a
+        // silent mutation of somebody else's board.
+        conn.pragma_update(None, "query_only", "ON")?;
+        Ok(Self {
+            conn,
+            path: path.to_path_buf(),
+        })
+    }
+
+    pub fn conn(&self) -> &Connection {
+        &self.conn
+    }
+
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// True when `table` exists in this database.
+    pub fn has_table(&self, table: &str) -> Result<bool> {
+        let count: i64 = self.conn.query_row(
+            "SELECT COUNT(*) FROM sqlite_master WHERE type IN ('table','view') AND name = ?1",
+            [table],
+            |row| row.get(0),
+        )?;
+        Ok(count > 0)
+    }
+
+    /// Column names of `table`, empty when the table is absent.
+    pub fn columns(&self, table: &str) -> Result<Vec<String>> {
+        if !self.has_table(table)? {
+            return Ok(Vec::new());
+        }
+        let mut statement = self
+            .conn
+            .prepare(&format!("PRAGMA table_info(\"{}\")", table.replace('"', "")))?;
+        let rows = statement.query_map([], |row| row.get::<_, String>(1))?;
+        let mut columns = Vec::new();
+        for column in rows {
+            columns.push(column?);
+        }
+        Ok(columns)
+    }
+
+    /// Verify that `table` exists and carries every column in `required`.
+    pub fn require_columns(&self, table: &str, required: &[&str]) -> Result<()> {
+        let columns = self.columns(table)?;
+        if columns.is_empty() {
+            anyhow::bail!("required table `{table}` is missing");
+        }
+        for column in required {
+            if !columns.iter().any(|found| found == column) {
+                anyhow::bail!("required column `{table}.{column}` is missing");
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Resolve the two store files without creating anything.
+///
+/// Mirrors [`crate::db::Database`]'s layout exactly — `index.db` beside a
+/// `projects/<sha256-path-hash>.db` — by calling the same hash function, so a
+/// reader and the owner can never disagree about which file a project is in.
+pub struct StoreLayout {
+    pub data_root: PathBuf,
+}
+
+impl StoreLayout {
+    pub fn new(data_root: impl Into<PathBuf>) -> Self {
+        Self {
+            data_root: data_root.into(),
+        }
+    }
+
+    pub fn index_db(&self) -> PathBuf {
+        self.data_root.join("index.db")
+    }
+
+    pub fn project_db(&self, project_path: &Path) -> PathBuf {
+        let hash = crate::db::Database::observer_path_hash(&project_path.to_string_lossy());
+        self.data_root.join("projects").join(format!("{hash}.db"))
+    }
+
+    pub fn project_path_hash(&self, project_path: &Path) -> String {
+        crate::db::Database::observer_path_hash(&project_path.to_string_lossy())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rusqlite::params;
+
+    fn seed(path: &Path) {
+        let conn = Connection::open(path).unwrap();
+        conn.execute_batch(
+            "CREATE TABLE tasks (id TEXT PRIMARY KEY, status TEXT NOT NULL);
+             CREATE TABLE task_runtime (task_id TEXT PRIMARY KEY);",
+        )
+        .unwrap();
+        conn.execute("INSERT INTO tasks VALUES (?1, ?2)", params!["a", "backlog"])
+            .unwrap();
+    }
+
+    #[test]
+    fn open_rejects_a_missing_file() {
+        let dir = tempfile::tempdir().unwrap();
+        let missing = dir.path().join("absent.db");
+        assert!(ReadOnlyDb::open(&missing).is_err());
+        assert!(!missing.exists(), "a read-only open must not create the file");
+    }
+
+    #[test]
+    fn writes_are_refused() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("p.db");
+        seed(&path);
+        let db = ReadOnlyDb::open(&path).unwrap();
+        assert!(db.conn().execute("DELETE FROM tasks", []).is_err());
+        assert!(
+            db.conn()
+                .execute_batch("CREATE TABLE x (a TEXT)")
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn introspection_reports_missing_tables_and_columns() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("p.db");
+        seed(&path);
+        let db = ReadOnlyDb::open(&path).unwrap();
+        assert!(db.has_table("tasks").unwrap());
+        assert!(!db.has_table("notifications").unwrap());
+        assert!(db.require_columns("tasks", &["id", "status"]).is_ok());
+        assert!(db.require_columns("tasks", &["id", "cycle"]).is_err());
+        assert!(db.require_columns("notifications", &["id"]).is_err());
+    }
+
+    #[test]
+    fn layout_matches_the_owner_hash() {
+        let layout = StoreLayout::new("/tmp/root");
+        let project = Path::new("/tmp/work/repo");
+        let expected = crate::db::Database::observer_path_hash("/tmp/work/repo");
+        assert_eq!(
+            layout.project_db(project),
+            Path::new("/tmp/root/projects").join(format!("{expected}.db"))
+        );
+        assert_eq!(layout.index_db(), Path::new("/tmp/root/index.db"));
+    }
+}
