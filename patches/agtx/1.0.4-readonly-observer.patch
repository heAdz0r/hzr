+#[test]
+fn repeated_snapshots_leave_the_store_byte_identical() {
+    let store = store();
+    let conn = seed(&store);
+    insert_task(&conn, "task-a", "running", None);
+    seed_index(&store);
+    drop(conn);
+
+    let layout = readonly::StoreLayout::new(&store.root);
+    let db_path = layout.project_db(&store.project);
+    let before = std::fs::read(&db_path).unwrap();
+    let schema_before = schema_of(&db_path);
+
+    for _ in 0..5 {
+        snapshot(&request(&store), NOW_MS).unwrap();
+    }
+
+    assert_eq!(before, std::fs::read(&db_path).unwrap());
+    assert_eq!(schema_before, schema_of(&db_path));
+    assert!(
+        !db_path.with_extension("db-wal").exists(),
+        "an observer read must not create a WAL for a rollback-journal store"
+    );
+}
