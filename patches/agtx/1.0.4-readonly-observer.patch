+#[test]
+fn titles_are_withheld_unless_asked_for_and_sanitised_when_they_are() {
+    let store = store();
+    let conn = seed(&store);
+    conn.execute(
+        "INSERT INTO tasks (id, title, status, agent, project_id, worktree_path, cycle,
+                            branch_name, created_at, updated_at)
+         VALUES ('task-a', ?1, 'running', 'claude', 'proj-1', '/work/repo', 1, 'feat/x',
+                 '2026-09-01T10:00:00+00:00', '2026-09-01T11:00:00+00:00')",
+        params![format!("Wire the retry budget\u{1b}[31m\n{}", "x".repeat(400))],
+    )
+    .unwrap();
+    seed_index(&store);
+    drop(conn);
+
+    let withheld = snapshot(&request(&store), NOW_MS).unwrap();
+    assert_eq!(withheld.tasks[0].title, None);
+    assert_eq!(withheld.tasks[0].branch, None);
+
+    let mut with_titles = request(&store);
+    with_titles.include_titles = true;
+    let shown = snapshot(&with_titles, NOW_MS).unwrap();
+    let title = shown.tasks[0].title.clone().expect("title");
+    assert!(title.starts_with("Wire the retry budget"));
+    assert!(!title.contains('\u{1b}'), "escapes are stripped, not echoed");
+    assert!(!title.contains('\n'));
+    assert!(title.chars().count() <= 160, "titles are bounded");
+    assert_eq!(shown.tasks[0].branch.as_deref(), Some("feat/x"));
+}
