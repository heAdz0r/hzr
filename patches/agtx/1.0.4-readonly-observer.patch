+#[test]
+fn snapshot_exports_state_without_any_prose() {
+    let store = store();
+    let conn = seed(&store);
+    insert_task(&conn, "task-a", "running", None);
+    insert_task(&conn, "task-b", "review", Some("task-a, task-missing"));
+    seed_index(&store);
+    drop(conn);
+
+    let snapshot = snapshot(&request(&store), NOW_MS).unwrap();
+    let encoded = encode_response(&snapshot).unwrap();
+    assert!(
+        !encoded.contains("secret title"),
+        "titles must never leave the store"
+    );
+    assert!(!encoded.contains("/work/repo"), "no worktree paths on the wire");
+    assert_eq!(snapshot.tasks.len(), 2);
+    assert_eq!(snapshot.tasks[0].board_status, "running");
+    assert_eq!(snapshot.tasks[0].cycle, 2);
+    assert!(snapshot.tasks[0].has_worktree);
+    assert_eq!(snapshot.snapshot_consistency, "per_project_transaction");
+    assert!(snapshot.complete);
+    assert_eq!(snapshot.project.source_project_id.as_deref(), Some("proj-1"));
+    assert!(snapshot.source_instance_id.starts_with("gen:"));
+
+    let mut edges = snapshot.edges.clone();
+    edges.sort_by(|a, b| a.from_source_task_id.cmp(&b.from_source_task_id));
+    assert_eq!(edges.len(), 2);
+    assert_eq!(edges[0].from_source_task_id, "task-a");
+    assert!(edges[0].resolved);
+    assert_eq!(edges[1].from_source_task_id, "task-missing");
+    assert!(!edges[1].resolved, "an unknown reference stays visible");
+}
