+//! `hzr-agtx-observer` — one bounded read-only snapshot of an agtx store.
+//!
+//! Deliberately not `agtx`: this binary has no TUI, no tmux, no MCP server, no
+//! web routes and no update check. It reads one request from stdin, opens the
+//! two SQLite files read-only, prints one JSON object to stdout and exits.
+//! stderr carries stable codes only.
+//!
+//! It never starts an agent, never writes to the store and never contacts the
+//! network.
+
+use agtx::observer;
+use std::io::Write;
+
+fn main() -> std::process::ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    match args.first().map(String::as_str) {
+        Some("--version" | "-V") => {
+            println!(
+                "hzr-agtx-observer {} schema={} patch={}",
+                env!("CARGO_PKG_VERSION"),
+                observer::PROTOCOL_SCHEMA_VERSION,
+                observer::PATCH_IDENTITY
+            );
+            std::process::ExitCode::SUCCESS
+        }
+        Some("snapshot") if args.iter().any(|arg| arg == "--request-stdin") => run_snapshot(),
+        _ => {
+            eprintln!("usage_error");
+            eprintln!("usage: hzr-agtx-observer snapshot --request-stdin");
+            std::process::ExitCode::from(2)
+        }
+    }
+}
+
+fn run_snapshot() -> std::process::ExitCode {
+    let mut stdin = std::io::stdin().lock();
+    let request = match observer::read_request(&mut stdin) {
+        Ok(request) => request,
+        Err(error) => return fail("invalid_request", "unknown", &error),
+    };
+    let now_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| i64::try_from(elapsed.as_millis()).unwrap_or(i64::MAX))
+        .unwrap_or_default();
+    let response = match observer::snapshot(&request, now_ms) {
+        Ok(response) => response,
+        Err(error) => return fail("snapshot_failed", &request.request_id, &error),
+    };
+    match observer::encode_response(&response) {
+        Ok(encoded) => {
+            let mut stdout = std::io::stdout().lock();
+            if stdout.write_all(encoded.as_bytes()).is_err() || stdout.write_all(b"\n").is_err() {
+                return std::process::ExitCode::from(5);
+            }
+            std::process::ExitCode::SUCCESS
+        }
+        Err(error) => fail("response_too_large", &request.request_id, &error),
+    }
+}
+
+/// Emit a typed refusal on stdout and a bare code on stderr.
+///
+/// The detail line is the error's own message, which is composed here from
+/// path and schema facts only — never from database contents.
+fn fail(code: &str, request_id: &str, error: &anyhow::Error) -> std::process::ExitCode {
+    let payload = observer::SnapshotError {
+        schema_version: observer::PROTOCOL_SCHEMA_VERSION,
+        request_id: request_id.to_string(),
+        error: code.to_string(),
+        detail: error.to_string(),
+    };
+    if let Ok(encoded) = serde_json::to_string(&payload) {
+        println!("{encoded}");
+    }
+    eprintln!("{code}");
+    std::process::ExitCode::from(1)
+}
