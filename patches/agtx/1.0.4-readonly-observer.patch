+#[test]
+fn hook_records_drop_prose_and_transcripts_and_flag_stale_working() {
+    let store = store();
+    let conn = seed(&store);
+    insert_task(&conn, "task-a", "running", None);
+    insert_task(&conn, "task-b", "running", None);
+    seed_index(&store);
+    drop(conn);
+
+    let dir = store.project.join(STATUS_DIR);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(
+        dir.join("task-a.json"),
+        serde_json::json!({
+            "ts": NOW_MS / 1000 - 10,
+            "state": "blocked",
+            "session_id": "sess-777",
+            "transcript_path": "/home/user/.claude/transcripts/secret.jsonl",
+            "message": "May I delete everything?",
+            "tool": "Bash",
+            "agent": "claude"
+        })
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        dir.join("task-b.json"),
+        serde_json::json!({
+            "ts": NOW_MS / 1000 - 4_000,
+            "state": "working",
+            "agent": "claude"
+        })
+        .to_string(),
+    )
+    .unwrap();
+
+    let snapshot = snapshot(&request(&store), NOW_MS).unwrap();
+    let encoded = encode_response(&snapshot).unwrap();
+    assert!(!encoded.contains("transcripts"));
+    assert!(!encoded.contains("May I delete"));
+    assert!(!encoded.contains("Bash"));
+
+    let a = snapshot.tasks[0].hook.clone().unwrap();
+    assert_eq!(a.state, "blocked");
+    assert_eq!(a.session_id.as_deref(), Some("sess-777"));
+    assert!(!a.working_stale, "Blocked never decays");
+
+    let b = snapshot.tasks[1].hook.clone().unwrap();
+    assert_eq!(b.state, "working");
+    assert!(b.working_stale, "Working past the guard is flagged, not dropped");
+}
