@@ -0,0 +1,862 @@
+//! Bounded, read-only snapshot export for an external monitor.
+//!
+//! This is the whole of the observer surface: one request in, one snapshot out,
+//! nothing written, nothing started. It exists because a monitor that wants to
+//! *look* at an agtx board should not have to link the TUI, the MCP server or
+//! the web routes — all of which can move a task, start an agent or answer a
+//! permission prompt — and should not have to reimplement the store layout,
+//! the status vocabulary or the `referenced_tasks` parse, all of which would
+//! then silently drift from this repository.
+//!
+//! What is deliberately *not* exported: task descriptions, worktree paths, PR
+//! URLs, notification prose, hook `message`/`tool` text and `transcript_path`.
+//! A monitor gets state, identity and timing, and every path that would let a
+//! reader go looking for more of it stays in the store.
+//!
+//! The one piece of human text that *can* cross, and only when the caller asks
+//! for it, is the task title — with its branch name — because a board labelled
+//! only by opaque ids is unusable: nobody can tell which task is which. It is
+//! bounded, stripped of control characters, and off unless
+//! `include_titles` is set.
+
+pub mod readonly;
+
+use anyhow::{Context, Result};
+use chrono::{DateTime, Utc};
+use rusqlite::OptionalExtension;
+use serde::{Deserialize, Serialize};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+
+use crate::agent::hook_status::{AgentHookStatus, HookState, STATUS_DIR};
+use crate::db::TaskStatus;
+use readonly::{ReadOnlyDb, StoreLayout};
+
+/// Wire protocol major version. A consumer that does not recognise it must
+/// refuse the payload rather than guess at the fields.
+pub const PROTOCOL_SCHEMA_VERSION: u32 = 1;
+
+/// Identity of this patch series, so a consumer can tell an adapted binary from
+/// an upstream one that happens to share a version string.
+pub const PATCH_IDENTITY: &str = "hzr-agtx-readonly-observer-1";
+
+pub const MAX_REQUEST_BYTES: usize = 64 * 1024;
+pub const MAX_RESPONSE_BYTES: usize = 2 * 1024 * 1024;
+pub const MAX_TASKS_PER_PAGE: usize = 200;
+pub const MAX_EDGES_PER_PAGE: usize = 1_000;
+pub const MAX_TASKS_PER_CYCLE: usize = 1_000;
+
+/// Longest identifier or label echoed back. Anything longer is a corrupt or
+/// hostile row, not a task id.
+const MAX_ID_CHARS: usize = 256;
+/// Longest agent/model label echoed back.
+const MAX_LABEL_CHARS: usize = 128;
+/// Longest task title echoed back when the caller asked for titles. Long enough
+/// to recognise a task, short enough that a hostile row cannot flood a reader.
+const MAX_TITLE_CHARS: usize = 160;
+
+/// One bounded request for one enrolled project.
+#[derive(Debug, Clone, Deserialize, Serialize)]
+pub struct SnapshotRequest {
+    pub schema_version: u32,
+    pub request_id: String,
+    /// Explicit store root. Never defaulted from the environment: the caller
+    /// enrolled a path and that is the only one this reads.
+    pub data_root: PathBuf,
+    /// Canonical worktree of the enrolled project.
+    pub project_path: PathBuf,
+    #[serde(default)]
+    pub cursor: Option<String>,
+    #[serde(default)]
+    pub task_limit: Option<usize>,
+    #[serde(default)]
+    pub edge_limit: Option<usize>,
+    /// Read `.agtx/status/<task>.json` under the enrolled worktree. Off means
+    /// board and runtime state only.
+    #[serde(default = "default_true")]
+    pub include_titles: bool,
+    #[serde(default = "default_true")]
+    pub include_hook_status: bool,
+}
+
+fn default_true() -> bool {
+    true
+}
+
+/// What the store could and could not answer.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq, Eq)]
+pub struct SnapshotCapabilities {
+    pub tasks: bool,
+    pub task_runtime: bool,
+    pub notifications: bool,
+    pub running_agents: bool,
+    pub hook_status: bool,
+}
+
+/// Board status as stored, normalised through [`TaskStatus`] so an unrecognised
+/// string is reported as unknown instead of being mapped onto a neighbour.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedTask {
+    pub source_task_id: String,
+    pub source_project_id: String,
+    /// The task's own title, present only when the request asked for titles.
+    /// Bounded and stripped of control characters; still untrusted text, and
+    /// still never HTML.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub title: Option<String>,
+    /// Branch name, on the same terms as the title.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub branch: Option<String>,
+    /// One of the five board columns, or `unknown`.
+    pub board_status: String,
+    /// The raw stored string when it did not resolve to a board column.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub unknown_board_status: Option<String>,
+    pub agent: String,
+    pub cycle: i64,
+    pub referenced_task_ids: Vec<String>,
+    pub has_worktree: bool,
+    pub source_created_at_ms: Option<i64>,
+    pub source_updated_at_ms: Option<i64>,
+    /// Runtime phase published by a live TUI, when present.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub runtime: Option<ObservedRuntime>,
+    /// Agent-reported lifecycle record from the worktree, when present.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub hook: Option<ObservedHook>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedRuntime {
+    /// `working | blocked | idle | ready | exited | unknown`.
+    pub phase_status: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub unknown_phase_status: Option<String>,
+    /// When the publishing TUI last rewrote the row. A reader must judge
+    /// freshness by this, not by when the snapshot was taken.
+    pub updated_at_ms: Option<i64>,
+    pub pane_changed_at_ms: Option<i64>,
+}
+
+/// Hook evidence, stripped to what correlation needs.
+///
+/// `message`, `tool` and `transcript_path` are read from the record and thrown
+/// away here: the first two are free text an agent wrote, and the third is a
+/// path to a full conversation transcript that nothing downstream is allowed to
+/// open.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedHook {
+    /// `working | blocked | waiting | ended`.
+    pub state: String,
+    pub recorded_at_ms: i64,
+    pub agent: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub session_id: Option<String>,
+    /// True when the record is a `Working` one past the upstream stale
+    /// threshold. Reported, not hidden: only `Working` decays, and a `Blocked`
+    /// record stays authoritative however old it is.
+    pub working_stale: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedEdge {
+    pub from_source_task_id: String,
+    pub to_source_task_id: String,
+    pub kind: String,
+    /// False when `from` names a task that is not in the store.
+    pub resolved: bool,
+}
+
+/// A structured upstream notification, without its prose.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedNotification {
+    pub source_notification_id: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub source_task_id: Option<String>,
+    /// `phase_completed | task_stuck | unknown`.
+    pub kind: String,
+    pub created_at_ms: Option<i64>,
+}
+
+/// A row from the global `running_agents` table for this project.
+///
+/// `session_name` is not exported. It is a tmux display name built from a
+/// truncated id and a slug of the task title, so it leaks the title and is not
+/// a safe join key.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ObservedRunningAgent {
+    pub source_task_id: String,
+    pub agent_name: String,
+    pub status: String,
+    pub started_at_ms: Option<i64>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct SnapshotProject {
+    /// Upstream project row id, when the project is registered in `index.db`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub source_project_id: Option<String>,
+    /// The 16-hex path hash that names the project database file.
+    pub project_path_hash: String,
+}
+
+/// One snapshot page.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SnapshotResponse {
+    pub schema_version: u32,
+    pub request_id: String,
+    pub upstream_version: String,
+    pub upstream_commit: String,
+    pub patch_identity: String,
+    /// Fingerprint of the *store generation*. A deleted and recreated store
+    /// produces a different value, which is how a consumer avoids stitching two
+    /// unrelated histories together.
+    pub source_instance_id: String,
+    pub observed_at_ms: i64,
+    pub snapshot_id: String,
+    /// Always `per_project_transaction`: the project database is read in one
+    /// transaction, but `index.db` is a separate file and separate read.
+    pub snapshot_consistency: String,
+    pub project: SnapshotProject,
+    pub capabilities: SnapshotCapabilities,
+    pub tasks: Vec<ObservedTask>,
+    pub edges: Vec<ObservedEdge>,
+    pub notifications: Vec<ObservedNotification>,
+    pub running_agents: Vec<ObservedRunningAgent>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub next_cursor: Option<String>,
+    /// True only when this page ended the traversal.
+    pub complete: bool,
+    pub warnings: Vec<SnapshotWarning>,
+}
+
+/// A stable machine code plus a bounded count. Never the offending content.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct SnapshotWarning {
+    pub code: String,
+    pub count: u32,
+}
+
+impl SnapshotWarning {
+    fn new(code: &str, count: u32) -> Self {
+        Self {
+            code: code.to_string(),
+            count,
+        }
+    }
+}
+
+/// A refusal, emitted as JSON on stdout with a stable code.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SnapshotError {
+    pub schema_version: u32,
+    pub request_id: String,
+    pub error: String,
+    pub detail: String,
+}
+
+fn bounded(value: &str, limit: usize) -> Option<String> {
+    if value.is_empty() || value.chars().count() > limit {
+        return None;
+    }
+    if value.chars().any(|c| c.is_control()) {
+        return None;
+    }
+    Some(value.to_string())
+}
+
+/// Bound one piece of human text without rejecting it outright.
+///
+/// Unlike [`bounded`], a title is prose: it may contain spaces, punctuation and
+/// non-ASCII, so it is *sanitised* rather than refused. Control characters —
+/// including the ANSI escapes a hostile row would use — are removed, and the
+/// result is truncated.
+fn bounded_text(value: &str, limit: usize) -> Option<String> {
+    let cleaned: String = value
+        .chars()
+        .filter(|character| !character.is_control())
+        .take(limit)
+        .collect();
+    let trimmed = cleaned.trim();
+    (!trimmed.is_empty()).then(|| trimmed.to_string())
+}
+
+fn parse_ms(raw: Option<String>) -> Option<i64> {
+    let raw = raw?;
+    DateTime::parse_from_rfc3339(&raw)
+        .ok()
+        .map(|value| value.with_timezone(&Utc).timestamp_millis())
+}
+
+/// Parse the comma-separated `referenced_tasks` field.
+///
+/// Shares [`crate::tui::dep_graph::parse_referenced_task_ids`] with the board so
+/// a monitor and the TUI cannot disagree about what a dependency is. Unlike the
+/// board's graph builder, unknown ids are *kept*: a reference to a task that is
+/// not in the store is evidence of a gap, and dropping it silently is what the
+/// board can afford and a monitor cannot.
+fn referenced_ids(raw: &Option<String>) -> Vec<String> {
+    crate::tui::dep_graph::parse_referenced_task_ids(raw)
+        .into_iter()
+        .filter_map(|id| bounded(&id, MAX_ID_CHARS))
+        .collect()
+}
+
+struct Quarantine {
+    oversize_rows: u32,
+    unparsable_rows: u32,
+}
+
+/// Build one snapshot page. Reads only; never creates, migrates or writes.
+pub fn snapshot(request: &SnapshotRequest, now_ms: i64) -> Result<SnapshotResponse> {
+    if request.schema_version != PROTOCOL_SCHEMA_VERSION {
+        anyhow::bail!(
+            "unsupported request schema_version {} (expected {})",
+            request.schema_version,
+            PROTOCOL_SCHEMA_VERSION
+        );
+    }
+    if !request.data_root.is_absolute() || !request.project_path.is_absolute() {
+        anyhow::bail!("data_root and project_path must be absolute");
+    }
+    let task_limit = request
+        .task_limit
+        .unwrap_or(MAX_TASKS_PER_PAGE)
+        .clamp(1, MAX_TASKS_PER_PAGE);
+    let edge_limit = request
+        .edge_limit
+        .unwrap_or(MAX_EDGES_PER_PAGE)
+        .clamp(1, MAX_EDGES_PER_PAGE);
+
+    let layout = StoreLayout::new(&request.data_root);
+    let project_db_path = layout.project_db(&request.project_path);
+    let project_path_hash = layout.project_path_hash(&request.project_path);
+
+    let mut warnings = Vec::new();
+    let mut capabilities = SnapshotCapabilities::default();
+    let mut quarantine = Quarantine {
+        oversize_rows: 0,
+        unparsable_rows: 0,
+    };
+
+    let db = ReadOnlyDb::open(&project_db_path)
+        .with_context(|| format!("project store {:?} is not readable", project_db_path))?;
+    db.require_columns(
+        "tasks",
+        &[
+            "id",
+            "title",
+            "branch_name",
+            "status",
+            "agent",
+            "project_id",
+            "cycle",
+            "referenced_tasks",
+            "worktree_path",
+            "created_at",
+            "updated_at",
+        ],
+    )?;
+    capabilities.tasks = true;
+    capabilities.task_runtime = db.has_table("task_runtime")?;
+    capabilities.notifications = db.has_table("notifications")?;
+
+    let (tasks, next_cursor, complete) = read_tasks(
+        &db,
+        request.cursor.as_deref(),
+        task_limit,
+        request.include_titles,
+        &mut quarantine,
+    )?;
+
+    let edges = build_edges(&tasks, edge_limit, &mut warnings);
+    let runtime = if capabilities.task_runtime {
+        read_runtime(&db, &tasks)?
+    } else {
+        Vec::new()
+    };
+    let notifications = if capabilities.notifications {
+        read_notifications(&db, task_limit)?
+    } else {
+        Vec::new()
+    };
+
+    let mut tasks = tasks;
+    for (index, entry) in runtime {
+        tasks[index].runtime = Some(entry);
+    }
+
+    if request.include_hook_status {
+        let read = attach_hook_status(&request.project_path, &mut tasks, now_ms, &mut warnings);
+        capabilities.hook_status = read;
+    }
+
+    // `index.db` is a second file and a second read; the pair is not one atomic
+    // snapshot, which is exactly what `snapshot_consistency` says.
+    let (source_project_id, running_agents) = match ReadOnlyDb::open(&layout.index_db()) {
+        Ok(index) => {
+            capabilities.running_agents = index.has_table("running_agents")?;
+            let id = read_project_id(&index, &request.project_path)?;
+            let agents = if capabilities.running_agents {
+                read_running_agents(&index, id.as_deref(), task_limit)?
+            } else {
+                Vec::new()
+            };
+            (id, agents)
+        }
+        Err(_) => {
+            warnings.push(SnapshotWarning::new("index_db_unavailable", 1));
+            (None, Vec::new())
+        }
+    };
+
+    if quarantine.oversize_rows > 0 {
+        warnings.push(SnapshotWarning::new(
+            "quarantined_oversize_row",
+            quarantine.oversize_rows,
+        ));
+    }
+    if quarantine.unparsable_rows > 0 {
+        warnings.push(SnapshotWarning::new(
+            "quarantined_unparsable_row",
+            quarantine.unparsable_rows,
+        ));
+    }
+
+    let source_instance_id = source_generation(&project_path_hash, source_project_id.as_deref());
+    let snapshot_id = format!(
+        "{}:{}:{}",
+        source_instance_id,
+        now_ms,
+        request.cursor.as_deref().unwrap_or("start")
+    );
+
+    Ok(SnapshotResponse {
+        schema_version: PROTOCOL_SCHEMA_VERSION,
+        request_id: request.request_id.clone(),
+        upstream_version: env!("CARGO_PKG_VERSION").to_string(),
+        upstream_commit: option_env!("AGTX_OBSERVER_UPSTREAM_COMMIT")
+            .unwrap_or("unknown")
+            .to_string(),
+        patch_identity: PATCH_IDENTITY.to_string(),
+        source_instance_id,
+        observed_at_ms: now_ms,
+        snapshot_id,
+        snapshot_consistency: "per_project_transaction".to_string(),
+        project: SnapshotProject {
+            source_project_id,
+            project_path_hash,
+        },
+        capabilities,
+        tasks,
+        edges,
+        notifications,
+        running_agents,
+        next_cursor,
+        complete,
+        warnings,
+    })
+}
+
+/// Fingerprint the store generation.
+///
+/// The project row id is a UUID minted when the project was first registered,
+/// so a store that was deleted and rebuilt gets a new one. With no `index.db`
+/// row the fingerprint degrades to the path hash alone and is marked
+/// `nogen`, which a consumer must treat as "cannot prove this is the same
+/// store" rather than as continuity.
+fn source_generation(project_path_hash: &str, source_project_id: Option<&str>) -> String {
+    use sha2::{Digest, Sha256};
+    match source_project_id {
+        Some(id) => {
+            let mut hasher = Sha256::new();
+            hasher.update(project_path_hash.as_bytes());
+            hasher.update([0u8]);
+            hasher.update(id.as_bytes());
+            format!("gen:{}", hex_16(&hasher.finalize()))
+        }
+        None => format!("nogen:{project_path_hash}"),
+    }
+}
+
+fn hex_16(bytes: &[u8]) -> String {
+    bytes
+        .iter()
+        .take(8)
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+#[allow(clippy::type_complexity)]
+fn read_tasks(
+    db: &ReadOnlyDb,
+    cursor: Option<&str>,
+    limit: usize,
+    include_titles: bool,
+    quarantine: &mut Quarantine,
+) -> Result<(Vec<ObservedTask>, Option<String>, bool)> {
+    let after = cursor.unwrap_or("");
+    // `limit + 1` so the page knows whether another one follows without a
+    // second COUNT over the table.
+    let mut statement = db.conn().prepare(
+        "SELECT id, status, agent, project_id, cycle, referenced_tasks, worktree_path,
+                created_at, updated_at, title, branch_name
+           FROM tasks
+          WHERE id > ?1
+          ORDER BY id ASC
+          LIMIT ?2",
+    )?;
+    let rows = statement.query_map(
+        rusqlite::params![after, i64::try_from(limit + 1).unwrap_or(i64::MAX)],
+        |row| {
+            Ok((
+                row.get::<_, String>(0)?,
+                row.get::<_, String>(1)?,
+                row.get::<_, Option<String>>(2)?,
+                row.get::<_, Option<String>>(3)?,
+                row.get::<_, Option<i64>>(4)?,
+                row.get::<_, Option<String>>(5)?,
+                row.get::<_, Option<String>>(6)?,
+                row.get::<_, Option<String>>(7)?,
+                row.get::<_, Option<String>>(8)?,
+                row.get::<_, Option<String>>(9)?,
+                row.get::<_, Option<String>>(10)?,
+            ))
+        },
+    )?;
+
+    let mut tasks = Vec::new();
+    let mut overflow = false;
+    let mut last_id = None;
+    for row in rows {
+        let (id, status, agent, project_id, cycle, refs, worktree, created, updated, title, branch) =
+            match row {
+            Ok(row) => row,
+            Err(_) => {
+                quarantine.unparsable_rows = quarantine.unparsable_rows.saturating_add(1);
+                continue;
+            }
+        };
+        if tasks.len() == limit {
+            overflow = true;
+            break;
+        }
+        let Some(id) = bounded(&id, MAX_ID_CHARS) else {
+            quarantine.oversize_rows = quarantine.oversize_rows.saturating_add(1);
+            continue;
+        };
+        last_id = Some(id.clone());
+        let (board_status, unknown_board_status) = match TaskStatus::from_str(&status) {
+            Some(known) => (known.as_str().to_string(), None),
+            None => (
+                "unknown".to_string(),
+                Some(bounded(&status, MAX_LABEL_CHARS).unwrap_or_else(|| "invalid".into())),
+            ),
+        };
+        tasks.push(ObservedTask {
+            source_task_id: id,
+            title: include_titles
+                .then(|| title.as_deref().and_then(|value| bounded_text(value, MAX_TITLE_CHARS)))
+                .flatten(),
+            branch: include_titles
+                .then(|| branch.as_deref().and_then(|value| bounded_text(value, MAX_LABEL_CHARS)))
+                .flatten(),
+            source_project_id: project_id
+                .as_deref()
+                .and_then(|value| bounded(value, MAX_ID_CHARS))
+                .unwrap_or_default(),
+            board_status,
+            unknown_board_status,
+            agent: agent
+                .as_deref()
+                .and_then(|value| bounded(value, MAX_LABEL_CHARS))
+                .unwrap_or_default(),
+            cycle: cycle.unwrap_or(1),
+            referenced_task_ids: referenced_ids(&refs),
+            has_worktree: worktree.is_some_and(|path| !path.is_empty()),
+            source_created_at_ms: parse_ms(created),
+            source_updated_at_ms: parse_ms(updated),
+            runtime: None,
+            hook: None,
+        });
+    }
+
+    let next_cursor = if overflow { last_id } else { None };
+    Ok((tasks, next_cursor.clone(), next_cursor.is_none()))
+}
+
+fn build_edges(
+    tasks: &[ObservedTask],
+    limit: usize,
+    warnings: &mut Vec<SnapshotWarning>,
+) -> Vec<ObservedEdge> {
+    let known: std::collections::HashSet<&str> = tasks
+        .iter()
+        .map(|task| task.source_task_id.as_str())
+        .collect();
+    let mut edges = Vec::new();
+    let mut dropped = 0u32;
+    for task in tasks {
+        for dependency in &task.referenced_task_ids {
+            if edges.len() >= limit {
+                dropped = dropped.saturating_add(1);
+                continue;
+            }
+            edges.push(ObservedEdge {
+                from_source_task_id: dependency.clone(),
+                to_source_task_id: task.source_task_id.clone(),
+                kind: "depends_on".to_string(),
+                resolved: known.contains(dependency.as_str()),
+            });
+        }
+    }
+    if dropped > 0 {
+        warnings.push(SnapshotWarning::new("edge_limit_reached", dropped));
+    }
+    edges
+}
+
+fn read_runtime(db: &ReadOnlyDb, tasks: &[ObservedTask]) -> Result<Vec<(usize, ObservedRuntime)>> {
+    let mut statement = db.conn().prepare(
+        "SELECT phase_status, pane_changed_at, updated_at FROM task_runtime WHERE task_id = ?1",
+    )?;
+    let mut found = Vec::new();
+    for (index, task) in tasks.iter().enumerate() {
+        let row = statement
+            .query_row([&task.source_task_id], |row| {
+                Ok((
+                    row.get::<_, String>(0)?,
+                    row.get::<_, Option<String>>(1)?,
+                    row.get::<_, Option<String>>(2)?,
+                ))
+            })
+            .optional()?;
+        let Some((phase, pane_changed, updated)) = row else {
+            continue;
+        };
+        let (phase_status, unknown_phase_status) =
+            match crate::db::PhaseStatus::from_str(&phase) {
+                Some(known) => (known.as_str().to_string(), None),
+                None => (
+                    "unknown".to_string(),
+                    Some(bounded(&phase, MAX_LABEL_CHARS).unwrap_or_else(|| "invalid".into())),
+                ),
+            };
+        found.push((
+            index,
+            ObservedRuntime {
+                phase_status,
+                unknown_phase_status,
+                updated_at_ms: parse_ms(updated),
+                pane_changed_at_ms: parse_ms(pane_changed),
+            },
+        ));
+    }
+    Ok(found)
+}
+
+fn read_notifications(db: &ReadOnlyDb, limit: usize) -> Result<Vec<ObservedNotification>> {
+    // Read-only by construction: upstream's own consumer deletes rows as it
+    // drains them, and doing that here would steal events from the orchestrator.
+    let columns = db.columns("notifications")?;
+    if !columns.iter().any(|column| column == "kind") {
+        return Ok(Vec::new());
+    }
+    let mut statement = db.conn().prepare(
+        "SELECT id, task_id, kind, created_at
+           FROM notifications
+          WHERE kind IS NOT NULL
+          ORDER BY created_at DESC
+          LIMIT ?1",
+    )?;
+    let rows = statement.query_map(
+        [i64::try_from(limit).unwrap_or(i64::from(u16::MAX))],
+        |row| {
+            Ok((
+                row.get::<_, String>(0)?,
+                row.get::<_, Option<String>>(1)?,
+                row.get::<_, Option<String>>(2)?,
+                row.get::<_, Option<String>>(3)?,
+            ))
+        },
+    )?;
+    let mut notifications = Vec::new();
+    for row in rows.flatten() {
+        let (id, task_id, kind, created) = row;
+        let Some(id) = bounded(&id, MAX_ID_CHARS) else {
+            continue;
+        };
+        let kind = kind
+            .as_deref()
+            .and_then(crate::db::NotificationKind::from_str)
+            .map(|kind| kind.as_str().to_string())
+            .unwrap_or_else(|| "unknown".to_string());
+        notifications.push(ObservedNotification {
+            source_notification_id: id,
+            source_task_id: task_id.as_deref().and_then(|id| bounded(id, MAX_ID_CHARS)),
+            kind,
+            created_at_ms: parse_ms(created),
+        });
+    }
+    Ok(notifications)
+}
+
+fn read_project_id(index: &ReadOnlyDb, project_path: &Path) -> Result<Option<String>> {
+    if !index.has_table("projects")? {
+        return Ok(None);
+    }
+    let id = index
+        .conn()
+        .query_row(
+            "SELECT id FROM projects WHERE path = ?1",
+            [project_path.to_string_lossy().as_ref()],
+            |row| row.get::<_, String>(0),
+        )
+        .optional()?;
+    Ok(id.as_deref().and_then(|id| bounded(id, MAX_ID_CHARS)))
+}
+
+fn read_running_agents(
+    index: &ReadOnlyDb,
+    project_id: Option<&str>,
+    limit: usize,
+) -> Result<Vec<ObservedRunningAgent>> {
+    let Some(project_id) = project_id else {
+        return Ok(Vec::new());
+    };
+    let mut statement = index.conn().prepare(
+        "SELECT task_id, agent_name, status, started_at
+           FROM running_agents
+          WHERE project_id = ?1
+          ORDER BY started_at DESC
+          LIMIT ?2",
+    )?;
+    let rows = statement.query_map(
+        rusqlite::params![project_id, i64::try_from(limit).unwrap_or(i64::from(u16::MAX))],
+        |row| {
+            Ok((
+                row.get::<_, String>(0)?,
+                row.get::<_, String>(1)?,
+                row.get::<_, String>(2)?,
+                row.get::<_, Option<String>>(3)?,
+            ))
+        },
+    )?;
+    let mut agents = Vec::new();
+    for (task_id, agent_name, status, started) in rows.flatten() {
+        let Some(task_id) = bounded(&task_id, MAX_ID_CHARS) else {
+            continue;
+        };
+        agents.push(ObservedRunningAgent {
+            source_task_id: task_id,
+            agent_name: bounded(&agent_name, MAX_LABEL_CHARS).unwrap_or_default(),
+            status: bounded(&status, MAX_LABEL_CHARS).unwrap_or_else(|| "unknown".into()),
+            started_at_ms: parse_ms(started),
+        });
+    }
+    Ok(agents)
+}
+
+/// Read `.agtx/status/<task>.json` for each task, under the enrolled worktree only.
+///
+/// The path is composed here from the enrolled root and the task id — never
+/// taken from a database column — and the file must be a regular file, not a
+/// symlink, within the fixed status directory. A task id that is not a plain
+/// file-name component is refused outright.
+fn attach_hook_status(
+    worktree: &Path,
+    tasks: &mut [ObservedTask],
+    now_ms: i64,
+    warnings: &mut Vec<SnapshotWarning>,
+) -> bool {
+    let status_dir = worktree.join(STATUS_DIR);
+    if !status_dir.is_dir() {
+        return false;
+    }
+    let now_secs = now_ms / 1_000;
+    let mut refused = 0u32;
+    for task in tasks.iter_mut() {
+        if !is_safe_component(&task.source_task_id) {
+            refused = refused.saturating_add(1);
+            continue;
+        }
+        let path = status_dir.join(format!("{}.json", task.source_task_id));
+        let Ok(metadata) = std::fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if !metadata.is_file() {
+            refused = refused.saturating_add(1);
+            continue;
+        }
+        if metadata.len() > crate::agent::hook_status::MAX_PAYLOAD_BYTES as u64 {
+            refused = refused.saturating_add(1);
+            continue;
+        }
+        let Ok(raw) = std::fs::read_to_string(&path) else {
+            continue;
+        };
+        let Ok(status) = serde_json::from_str::<AgentHookStatus>(&raw) else {
+            refused = refused.saturating_add(1);
+            continue;
+        };
+        task.hook = Some(observed_hook(&status, now_secs));
+    }
+    if refused > 0 {
+        warnings.push(SnapshotWarning::new("hook_status_refused", refused));
+    }
+    true
+}
+
+fn observed_hook(status: &AgentHookStatus, now_secs: i64) -> ObservedHook {
+    let state = match status.state {
+        HookState::Working => "working",
+        HookState::Blocked => "blocked",
+        HookState::Waiting => "waiting",
+        HookState::Ended => "ended",
+    };
+    ObservedHook {
+        state: state.to_string(),
+        recorded_at_ms: status.ts.saturating_mul(1_000),
+        agent: bounded(&status.agent, MAX_LABEL_CHARS).unwrap_or_default(),
+        session_id: status
+            .session_id
+            .as_deref()
+            .and_then(|id| bounded(id, MAX_ID_CHARS)),
+        working_stale: status.state == HookState::Working
+            && now_secs.saturating_sub(status.ts) > crate::agent::hook_status::HOOK_STALE_SECS,
+    }
+}
+
+fn is_safe_component(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= MAX_ID_CHARS
+        && value
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.'))
+        && value != "."
+        && value != ".."
+}
+
+/// Read one bounded JSON request from stdin.
+pub fn read_request(reader: &mut impl Read) -> Result<SnapshotRequest> {
+    let mut buffer = Vec::new();
+    let read = reader
+        .take((MAX_REQUEST_BYTES + 1) as u64)
+        .read_to_end(&mut buffer)?;
+    if read > MAX_REQUEST_BYTES {
+        anyhow::bail!("request exceeds {MAX_REQUEST_BYTES} bytes");
+    }
+    serde_json::from_slice(&buffer).context("request is not valid JSON")
+}
+
+/// Serialise a response, refusing to emit one over the wire cap.
+pub fn encode_response(response: &SnapshotResponse) -> Result<String> {
+    let encoded = serde_json::to_string(response)?;
+    if encoded.len() > MAX_RESPONSE_BYTES {
+        anyhow::bail!("response exceeds {MAX_RESPONSE_BYTES} bytes");
+    }
+    Ok(encoded)
+}
