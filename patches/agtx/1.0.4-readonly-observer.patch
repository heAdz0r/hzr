+fn request(store: &Store) -> SnapshotRequest {
+    SnapshotRequest {
+        schema_version: PROTOCOL_SCHEMA_VERSION,
+        request_id: "req-1".into(),
+        data_root: store.root.clone(),
+        project_path: store.project.clone(),
+        cursor: None,
+        task_limit: None,
+        edge_limit: None,
+        include_titles: false,
+        include_hook_status: true,
+    }
+}
