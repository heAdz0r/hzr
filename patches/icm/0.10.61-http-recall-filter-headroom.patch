+/// HZR: how many candidates to ask the store for before the post-hoc filter
+/// (mirrors `tool_recall` and upstream's later `recall_query_limit` in the CLI).
+fn recall_query_limit(limit: usize, filters_active: bool) -> usize {
+    if filters_active {
+        (limit * 10).min(200)
+    } else {
+        limit
+    }
+}
