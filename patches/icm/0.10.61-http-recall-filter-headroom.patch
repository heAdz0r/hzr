+    /// HZR: the store truncates to `limit` across every topic before the
+    /// topic/project filter runs, so a filtered recall used to return nothing
+    /// when other topics outranked the only relevant memory.
+    #[test]
+    fn filtered_recall_is_not_starved_by_other_topics() {
+        let store = Store::in_memory().unwrap();
+        for i in 0..40 {
+            store
+                .store(Memory::new(
+                    "noise".into(),
+                    format!("widget widget widget {i}"),
+                    Importance::Medium,
+                ))
+                .unwrap();
+        }
+        store
+            .store(Memory::new(
+                "decisions-target".into(),
+                "the widget cache was replaced by a bounded queue with backpressure".into(),
+                Importance::Medium,
+            ))
+            .unwrap();
+        let state = AppState {
+            store: Arc::new(Mutex::new(store)),
+            embedder: None,
+            token: None,
+        };
+        let req = |topic: Option<&str>, project: Option<&str>| RecallReq {
+            query: "widget".into(),
+            topic: topic.map(str::to_string),
+            limit: Some(5),
+            keyword: None,
+            project: project.map(str::to_string),
+        };
+
+        let hits = run_recall(&state, &req(Some("decisions-target"), None)).unwrap();
+        assert_eq!(hits.len(), 1, "topic-filtered recall must find the memory");
+        assert_eq!(hits[0].0.topic, "decisions-target");
+
+        let hits = run_recall(&state, &req(None, Some("target"))).unwrap();
+        assert!(
+            hits.iter().any(|(m, _)| m.topic == "decisions-target"),
+            "project-filtered recall must find the memory"
+        );
+
+        // Unfiltered recall still honours the caller's limit.
+        assert_eq!(run_recall(&state, &req(None, None)).unwrap().len(), 5);
+        assert_eq!(recall_query_limit(5, false), 5);
+        assert_eq!(recall_query_limit(5, true), 50);
+        assert_eq!(recall_query_limit(100, true), 200);
+    }
